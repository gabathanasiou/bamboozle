{
  "name": "bamboozle",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "asset-generator": "vite -c tools/AssetGenerator/vite.config.ts",
    "android:build": "node scripts/build-native.js",
    "roadmap": "node scripts/roadmap.mjs",
    "roadmap:check": "node scripts/roadmap.mjs check",
    "lint": "npm run roadmap:check && npm run lint:docs",
    "postinstall": "cd server && npm install",
    "lint:docs": "node scripts/check-doc-budget.mjs",
    "lint:tests": "node scripts/check-doc-budget.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:worker": "npm --prefix workers/bamboozle-rooms test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:full": "playwright test",
    "test:smart": "node scripts/smart-test.mjs",
    "test:baseline": "node scripts/test-baseline.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@react-three/fiber": "^9.5.0",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4",
    "three": "^0.182.0",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.27",
    "html-to-image": "^1.11.13",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
